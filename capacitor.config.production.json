{
  "appId": "com.livechat.demo",
  "appName": "LiveChat Demo",
  "webDir": "public",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true,
    "backgroundColor": "#0d6efd"
  },
  "android": {
    "backgroundColor": "#0d6efd",
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0d6efd",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
